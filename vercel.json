{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "buildCommand": "node scripts/build-vercel-safe.js",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api/router?path="
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/api/v2",
      "destination": "/api/router?path="
    },
    {
      "source": "/api/v2/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/router?path="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/router?path=:path*"
    },
    {
      "source": "/server",
      "destination": "/index.html"
    },
    {
      "source": "/monitor",
      "destination": "/index.html"
    },
    {
      "source": "/monitor/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/router.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
